{
  "name": "klu-sports-portal",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "install:all": "npm install --prefix frontend",
    "dev": "concurrently -k -n API,WEB -c green,blue \"npm:server\" \"npm:client\"",
    "build": "npm --prefix frontend run build",
    "server": "backend-spring\\mvnw.cmd -f backend-spring\\pom.xml spring-boot:run",
    "spring:build": "backend-spring\\mvnw.cmd -f backend-spring\\pom.xml package -DskipTests",
    "client": "npm --prefix frontend run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
